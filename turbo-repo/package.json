{
  "name": "modulariot-tuborepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "storm": "turbo run storm",
    "lint": "turbo run lint --filter='!@modulariot/web-admin'",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types --filter='!@modulariot/web-admin'",
    "test": "turbo run test",
    "knip": "turbo run knip",
    "knip:check": "turbo run knip:check",
    "prepare": "husky",
    "postinstall": "patch-package",
    "sonarcloud:issues": "node packages/sonarcloud-tools/dist/cli.js issues -k microboxlabs_modulariot",
    "sonarcloud:rule-doc": "node packages/sonarcloud-tools/dist/cli.js rule-doc",
    "test:dependencies": "node --test tests/dependency-security.test.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "patch-package": "^8.0.1",
    "prettier": "^3.5.3",
    "sharp": "0.35.5",
    "turbo": "^2.9.18",
    "typescript": "5.8.2",
    "magicast": "0.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@luma.gl/core": "9.3.6",
    "@luma.gl/engine": "9.3.6",
    "@luma.gl/gltf": "9.3.6",
    "@luma.gl/shadertools": "9.3.6",
    "@luma.gl/webgl": "9.3.6",
    "esbuild": "0.28.1",
    "postcss": "8.5.32",
    "sharp": "$sharp",
    "dompurify": "^3.4.17",
    "fast-jwt": "^6.3.4",
    "fast-xml-parser": "^5.12.0",
    "postcss-selector-parser@6": "6.1.5",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@>=4": "5.0.13",
    "fflate@0.7": "0.7.5",
    "fflate@0.8": "0.8.3",
    "image-size": "2.0.3",
    "deepmerge-ts": "8.0.2",
    "uuid@>=7 <9": "11.1.1",
    "katex": "0.18.2",
    "vite": "8.1.6",
    "minimatch@>=7 <11": "11.0.8"
  },
  "packageManager": "npm@10.2.4",
  "dependencies": {
    "handlebars": "^4.7.10",
    "zod": "^4.6.6"
  }
}
