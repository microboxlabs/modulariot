[
  {
    "key": "speeding",
    "name": "Exceso de velocidad",
    "family": "Seguridad de conducción",
    "icon": "SPEED LIMIT STANDARD",
    "description": "En viaje y sobre el límite de la vía",
    "spec": {
      "source": "gps_signal",
      "activation": "signal.trip.active && signal.road.maxspeed_osm > 0",
      "measure": {"expression": "signal.gps.speed_kmh - signal.road.maxspeed_osm", "label": "Exceso sobre el límite", "unit": "km/h"},
      "levels": [
        {"icu": 1, "applies": true, "when": "medida > 0 && medida < 5", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 2, "applies": true, "when": "medida >= 5 && medida < 10", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 3, "applies": true, "when": "medida >= 10 && medida < 20", "response": {"operator": true, "slaMinutes": 15, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 4, "applies": true, "when": "medida >= 20 && sostenido_s >= 60", "response": {"operator": true, "slaMinutes": 5, "steps": [], "notices": [], "evidence": [], "ignorable": false}}
      ],
      "lifecycle": {"open": "caso.condicion_s >= 0", "close": "caso.normal_s >= 120"}
    }
  },
  {
    "key": "speeding-custom-limit",
    "name": "Exceso sobre el límite propio",
    "family": "Seguridad de conducción",
    "icon": "SPEED LIMIT CUSTOM",
    "description": "En viaje y sobre el límite que fija la organización para la zona",
    "spec": {
      "source": "gps_signal",
      "activation": "signal.trip.active && signal.road.maxspeed_custom > 0",
      "measure": {"expression": "signal.gps.speed_kmh - signal.road.maxspeed_custom", "label": "Exceso sobre el límite propio", "unit": "km/h"},
      "levels": [
        {"icu": 1, "applies": true, "when": "medida > 0 && medida < 5", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 2, "applies": true, "when": "medida >= 5 && medida < 10", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 3, "applies": true, "when": "medida >= 10 && medida < 20", "response": {"operator": true, "slaMinutes": 15, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 4, "applies": true, "when": "medida >= 20 && sostenido_s >= 60", "response": {"operator": true, "slaMinutes": 5, "steps": [], "notices": [], "evidence": [], "ignorable": false}}
      ],
      "lifecycle": {"open": "caso.condicion_s >= 0", "close": "caso.normal_s >= 120"}
    }
  },
  {
    "key": "night-stop-unauthorized",
    "name": "Detención nocturna fuera de zona autorizada",
    "family": "Zonas y lugares",
    "icon": "NIGHT STAY RISK",
    "description": "En viaje, detenido entre 21:00 y 06:00 fuera de una zona autorizada",
    "spec": {
      "source": "gps_signal",
      "activation": "signal.trip.active && !signal.gps.moving && !signal.geo.authorized_zone && (signal.local_hour >= 21 || signal.local_hour < 6)",
      "levels": [
        {"icu": 1, "applies": true, "when": "sostenido_s < 600", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 2, "applies": true, "when": "sostenido_s >= 600 && sostenido_s < 1200", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 3, "applies": true, "when": "sostenido_s >= 1200 && sostenido_s < 1800", "response": {"operator": true, "slaMinutes": 15, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 4, "applies": true, "when": "sostenido_s >= 1800", "response": {"operator": true, "slaMinutes": 10, "steps": [], "notices": [], "evidence": [], "ignorable": false}}
      ],
      "lifecycle": {"open": "caso.condicion_s >= 0", "close": "caso.normal_s >= 300"}
    }
  },
  {
    "key": "off-hours-driving",
    "name": "Conducción en horario no permitido",
    "family": "Jornada y fatiga",
    "icon": "OFF HOURS DRIVING",
    "description": "En viaje con un conductor y en movimiento entre 02:00 y 06:00",
    "spec": {
      "source": "gps_signal",
      "activation": "signal.trip.active && signal.gps.moving && !signal.trip.double_driver && signal.local_hour >= 2 && signal.local_hour < 6",
      "levels": [
        {"icu": 1, "applies": true, "when": "sostenido_s < 300", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 2, "applies": true, "when": "sostenido_s >= 300 && sostenido_s < 900", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 3, "applies": true, "when": "sostenido_s >= 900 && sostenido_s < 1800", "response": {"operator": true, "slaMinutes": 15, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 4, "applies": true, "when": "sostenido_s >= 1800", "response": {"operator": true, "slaMinutes": 10, "steps": [], "notices": [], "evidence": [], "ignorable": false}}
      ],
      "lifecycle": {"open": "caso.condicion_s >= 0", "close": "caso.normal_s >= 300"}
    }
  },
  {
    "key": "continuous-driving",
    "name": "Conducción continua",
    "family": "Jornada y fatiga",
    "icon": "CONTINUOUS DRIVE CHECK",
    "description": "En viaje con un conductor, conduciendo sin descanso",
    "spec": {
      "source": "trip_check",
      "activation": "check.trip.active && !check.trip.double_driver",
      "measure": {"expression": "check.driving_minutes", "label": "Minutos conduciendo seguido", "unit": "min"},
      "levels": [
        {"icu": 1, "applies": true, "when": "medida >= 270 && medida < 300", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 2, "applies": true, "when": "medida >= 300 && medida < 330", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 3, "applies": true, "when": "medida >= 330 && medida < 360", "response": {"operator": true, "slaMinutes": 15, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 4, "applies": true, "when": "medida >= 360", "response": {"operator": true, "slaMinutes": 10, "steps": [], "notices": [], "evidence": [], "ignorable": false}}
      ],
      "lifecycle": {"open": "caso.condicion_s >= 0", "close": "caso.normal_s >= 600"}
    }
  },
  {
    "key": "signal-loss",
    "name": "Pérdida de señal",
    "family": "Continuidad de señal",
    "icon": "LOST SIGNAL",
    "description": "En viaje y sin señales del GPS",
    "spec": {
      "source": "trip_check",
      "activation": "check.trip.active",
      "measure": {"expression": "check.signal_lost_minutes", "label": "Minutos sin señal", "unit": "min"},
      "levels": [
        {"icu": 1, "applies": true, "when": "medida >= 30 && medida < 90", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 2, "applies": true, "when": "medida >= 90 && medida < 120", "response": {"operator": false, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 3, "applies": true, "when": "medida >= 120 && medida < 180", "response": {"operator": true, "slaMinutes": 15, "steps": [], "notices": [], "evidence": [], "ignorable": true}},
        {"icu": 4, "applies": true, "when": "medida >= 180", "response": {"operator": true, "slaMinutes": 10, "steps": [], "notices": [], "evidence": [], "ignorable": false}}
      ],
      "lifecycle": {"open": "caso.condicion_s >= 0", "close": "caso.normal_s >= 600"}
    }
  },
  {
    "key": "panic-button",
    "name": "Botón de pánico",
    "family": "Emergencias",
    "icon": null,
    "description": "El conductor activa el botón de emergencia",
    "spec": {
      "source": "device_event",
      "activation": "event.type == \"SOS\"",
      "levels": [
        {"icu": 1, "applies": false, "when": null, "response": null},
        {"icu": 2, "applies": false, "when": null, "response": null},
        {"icu": 3, "applies": false, "when": null, "response": null},
        {"icu": 4, "applies": true, "when": "true", "response": {"operator": true, "slaMinutes": 2, "steps": [], "notices": [], "evidence": [], "ignorable": false}}
      ],
      "lifecycle": {"open": "caso.condicion_s >= 0", "close": "caso.cerrado_por_operador"}
    }
  }
]
