# ─── App (product) ────────────────────────────────────────────────
# Full URL (including path) of the sign-in screen on the actual product app
# (apps/app), which "Iniciar sesión" / "Crear cuenta" in the nav link to.
# The path varies per environment, so it's not hardcoded in the code — set
# the whole thing here.
# Local dev: apps/app's own dev port (see apps/app/package.json).
# Production: path-based on the main domain, e.g.
# https://modulariot.com/app/sign-in (reverse-proxied to apps/app) — set via
# the hosting platform's env vars.
NEXT_PUBLIC_APP_URL=http://localhost:3050/sign-in
