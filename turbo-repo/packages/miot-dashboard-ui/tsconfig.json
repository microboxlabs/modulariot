{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@microboxlabs/miot-dashboard-ui/document": ["./src/document.ts"]
    },
    "outDir": "dist",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "types": [],
    // Browser HTTP types; the pure core has a separate environment-free check.
    "lib": ["es2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "dist"]
}
