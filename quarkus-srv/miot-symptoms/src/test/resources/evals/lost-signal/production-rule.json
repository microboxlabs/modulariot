{
  "source": "trip_check",
  "activation": "check.trip.active && check.signal_lost",
  "levels": [
    { "icu": 1, "applies": true, "when": "check.signal_lost_minutes < 90" },
    { "icu": 2, "applies": true, "when": "check.signal_lost_minutes >= 90 && check.signal_lost_minutes < 120" },
    { "icu": 3, "applies": true, "when": "check.signal_lost_minutes >= 120 && check.signal_lost_minutes < 180" },
    { "icu": 4, "applies": true, "when": "check.signal_lost_minutes >= 180" }
  ],
  "lifecycle": {
    "open": "caso.condicion_s >= 0",
    "close": "caso.normal_s >= 0",
    "levelDown": true
  }
}
