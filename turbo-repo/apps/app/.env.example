# ─── Authentication ───────────────────────────────────────────────
AUTH_SECRET=your_auth_secret
AUTH_PROVIDER=ECM

# Auth0 (single OIDC broker — required for all OAuth/SAML providers, and for
# username/password sign-in). Username/password is validated against the Auth0
# database connection (password-realm grant — requires the Password grant
# enabled on the Auth0 application). When AUTH_AUTH0_* is unset, the
# username/password form is not offered.
# AUTH_AUTH0_ID=your_auth0_client_id
# AUTH_AUTH0_SECRET=your_auth0_client_secret
# AUTH_AUTH0_ISSUER=https://your-tenant.auth0.com
# AUTH_AUTH0_AUDIENCE=https://your-api-audience   # Required to get an API access_token (needed for harness)

# Auth0 connection names per provider (defaults shown; override per tenant).
# AUTH_AUTH0_CONNECTION_GOOGLE=google-oauth2
# AUTH_AUTH0_CONNECTION_GITHUB=github
# AUTH_AUTH0_CONNECTION_ENTRA_ID=Mintral-Entra-ID
# AUTH_AUTH0_CONNECTION_CREDENTIALS=Username-Password-Authentication

# Auth providers configuration (controls which login buttons are shown)
# All OAuth/SAML providers route through Auth0 — AUTH_AUTH0_* vars must be set.
# SaaS: AUTH_PROVIDERS=google,github,saml* (default, no need to set)
# Custom (Microsoft via Auth0): AUTH_PROVIDERS=microsoft-entra-id*,credentials
# Use * to mark primary providers (highlighted button)
AUTH_PROVIDERS=google,github,saml*

# Restrict who may sign in via OAuth/social (Auth0 → Google/Microsoft/etc.) to these
# email domains. Comma-separated; set per environment/instance. Leave unset/empty to
# allow all domains. Credentials (Alfresco) logins are not affected by this list.
# AUTH_ALLOWED_EMAIL_DOMAINS=microboxlabs.com,vialabs.net

# ─── ECM / Alfresco ─────────────────────────────────────────────
ECM_API_URL=https://your-ecm-host.com
NEXT_PUBLIC_ECM_API_URL=https://your-ecm-host.com
CONTEXT_ROOT=alfresco

# ─── Autentia ────────────────────────────────────────────────────
NEXT_PUBLIC_AUTENTIA_PATH="autentia-path"
NEXT_PUBLIC_SIMULATE_AUTENTIA=false

# ─── CAP (firma electrónica avanzada) ───────────────────────────
CAP_API_URL=https://your-cap-host.com
CAP_USER=your_cap_user
CAP_USER_PIN=your_cap_pin
CAP_API_KEY=your_cap_api_key

# ─── DEC5 ────────────────────────────────────────────────────────
DEC5_INSTITUTION=your_institution
DEC5_SIGNER_ROLES=your_signer_role
DEC5_TARGET_CONTENT_TYPE=your_content_type
DEC5_DISPATCHER_ROLE=your_dispatcher_role
DEC5_RECEIVER_ROLE=your_receiver_role

# ─── Google Maps ─────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Scraping ────────────────────────────────────────────────────
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/120.0.0.0"

# ─── StreamHub ───────────────────────────────────────────────────
# M2M credentials for GPS/symptoms/pgrest (StreamHub GKE cluster domain).
# Login broker: https://api.microboxlabs.com/api/v1/login (client_credentials).
STREAMHUB_CLIENT_ID=your_client_id
STREAMHUB_CLIENT_SECRET=your_client_secret
STREAMHUB_AUDIENCE=https://iot.streamhub.cl/v1/asset/track
STREAMHUB_URL=https://pgrest.streamhub.cl
STREAMHUB_IOT_URL=https://iot.streamhub.cl

# StreamHub-facing modulith base (GPS webhook control plane). Separate from
# MIOT_MODULITH_URL so coordinator and StreamHub backends can diverge.
# Local: often the same as MIOT_MODULITH_URL (http://localhost:8180/miot).
# Auth: session (default, user JWT for Settings UI) | m2m (STREAMHUB_* token).
# MIOT_STREAMHUB_API_URL=http://localhost:8180/miot
# MIOT_STREAMHUB_AUTH=session

# ─── Fleet Management — temporary pgrest source ──────────────────
# TEMPORARY bypass: when MIOT_FLEET_SOURCE=pgrest, /api/fleet/trucks
# proxies to the prod streamhub pgrest instance instead of the quarkus
# fleet backend. Reuses the existing STREAMHUB_* M2M credentials above
# (token rotation via AuthToken). Remove once quarkus exposes equivalent
# telemetry.
MIOT_FLEET_SOURCE=quarkus

# ─── External Tasks (n8n webhooks) ─────────────────────────────────
EXT_TASKS_WEBHOOK_URL=https://router.streamhub.cl/webhook/{workflow-id}

# ─── Mapbox ──────────────────────────────────────────────────────
NEXT_PUBLIC_DISPLAY_GEOGRAPHIC_VIEW=TRUE
MAPBOX_API_KEY=your_mapbox_api_key

# ─── Feature flags ──────────────────────────────────────────────
NEXT_PUBLIC_SKIP_DRIVER_VERIFICATION=true
# Per-origin rollout of the task-driven planner. Listed origins skip the
# legacy synchronous /mintral/calendar/binding call: the planner advances the
# workflow task and ECM projects the booking + notifies Alerce via the async
# job outbox. Booking moves for listed origins are forwarded slot-only — the
# planner's frozen resource blob is never merged onto the booking and no
# binding/Alerce call fires on a re-slot. EXACT string match against the
# service's origen / mintral_originDelegateCode — delegation codes
# (SCL, ANF, …), not names.
# Empty/unset = every origin takes the legacy in-request Alerce push.
TASK_DRIVEN_ORIGINS=

# ─── OpenAPI ─────────────────────────────────────────────────────
OPENAPI_URL=https://your-openapi-host.com
OPENAPI_TOKEN=your_api_token_here

# ─── Calendar ────────────────────────────────────────────────────
MIOT_CALENDAR_URL=https://your-calendar-host.com
MIOT_DEFAULT_ORG_ID=your_organization_id

# ─── Modulith gateway ───────────────────────────────────────────
# Base host of the Quarkus gateway. Replaces MIOT_HARNESS_URL and
# MIOT_RESOURCE_URL (see #1126).
MIOT_MODULITH_URL=https://your-quarkus-host.com

# Shows the "Dev" sidebar section. Leave unset in production.
# ENABLE_DEV_TOOLS=true

# Shows the "Storytelling" sidebar section and its /storytelling routes, and
# lets the chat's storytelling demo trigger words ("create a story", "show
# all dashlets") fire. Testing-only for now — leave unset in production.
# ENABLE_STORYTELLING=true
# Gates the Settings > Harness page (seats/pricing/usage preview UI, ahead of
# the real billing integration) and its sidebar link. Server-only — resolved
# in SecuredLayout and passed down as a prop, never exposed to the client
# bundle. Set to "true" to make the page reachable and show the link; any
# other value (or unset) 404s the route and hides the link.
ENABLE_HARNESS_SETTINGS=false

# ─── Dashlet ingestion ───────────────────────────────────────────
# Audit metadata stamped on every imported row by the batch_import dashlet.
# DASHLET_INGESTION_SCHEMA_VERSION can be overridden per-dashlet from the
# widget settings UI.
# DASHLET_INGESTION_TIMEZONE=America/Santiago
# DASHLET_INGESTION_CLIENT_ID=
# DASHLET_INGESTION_SCHEMA_VERSION=
