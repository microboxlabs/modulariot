{
  "source": "gps_signal",
  "activation": "signal.trip.active && !signal.trip.double_driver && !signal.gps.moving && !signal.geo.authorized_zone && (signal.local_hour >= 21 || signal.local_hour < 6)",
  "levels": [
    { "icu": 1, "applies": true, "when": "sostenido_s < 600" },
    { "icu": 2, "applies": true, "when": "sostenido_s >= 600 && sostenido_s < 1200" },
    { "icu": 3, "applies": true, "when": "sostenido_s >= 1200 && sostenido_s < 1800" },
    { "icu": 4, "applies": true, "when": "sostenido_s >= 1800" }
  ],
  "lifecycle": {
    "open": "caso.condicion_s >= 0",
    "close": "caso.normal_s >= 0"
  }
}
