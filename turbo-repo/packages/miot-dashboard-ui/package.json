{
  "name": "@microboxlabs/miot-dashboard-ui",
  "version": "0.1.2",
  "description": "Reusable dashboard UI utilities using the MIOT dashboard contract.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microboxlabs/modulariot.git",
    "directory": "turbo-repo/packages/miot-dashboard-ui"
  },
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    },
    "./styles.css": "./styles.css",
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/web-component.js"
    },
    "./browser": {
      "types": "./dist/browser/browser.d.ts",
      "import": "./dist/browser/browser.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./react-charts": {
      "types": "./dist/react-charts.d.ts",
      "import": "./dist/react-charts.js"
    },
    "./browser-charts": {
      "types": "./dist/browser/browser-charts.d.ts",
      "import": "./dist/browser/browser-charts.js"
    }
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/check-browser.mjs",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit && node scripts/guard-imports.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@microboxlabs/miot-dashboard-contract": "^0.6.0",
    "zod": "^3.23.8",
    "handlebars": "^4.7.9",
    "react-grid-layout": "2.2.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@vitest/coverage-v8": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.8.2",
    "vitest": "^5.0.0",
    "react": "19.2.3",
    "@types/react": "19.2.10",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^24.0.0",
    "react-dom": "19.2.3",
    "react-draggable": "4.5.0",
    "echarts": "6.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "echarts": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "echarts": {
      "optional": true
    }
  }
}
