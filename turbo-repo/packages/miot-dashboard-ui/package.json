{
  "name": "@microboxlabs/miot-dashboard-ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/microboxlabs/modulariot",
    "directory": "packages/miot-dashboard-ui"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./schema/dashboard-config.schema.json": "./schema/dashboard-config.schema.json",
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "schema",
    "styles.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/generate-json-schema.mjs",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "check-types": "tsc --noEmit && node scripts/guard-imports.mjs",
    "guard": "node scripts/guard-imports.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.2.5"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "zod-to-json-schema": "^3.24.5",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "swr": "^2.2.5",
    "tsup": "^8.0.0",
    "typescript": "5.8.2",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
