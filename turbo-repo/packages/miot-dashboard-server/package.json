{
  "name": "@microboxlabs/miot-dashboard-server",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/microboxlabs/modulariot",
    "directory": "packages/miot-dashboard-server"
  },
  "description": "Framework-agnostic backend services for MIOT embeddable dashboards: persistence, identity and tenancy, datasource proxying, embed tokens.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "miot-dashboard-server": "./dist/bin.js"
  },
  "files": [
    "dist",
    "contract"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "dev:server": "MIOT_DASHBOARD_INSECURE_AUTH=true MIOT_DASHBOARD_SEED=examples/seed.json tsx watch src/bin.ts",
    "start": "node dist/bin.js",
    "test:api": "npm --prefix rest-api run test:api",
    "lint": "eslint .",
    "check-types": "tsc --noEmit && node scripts/guard-imports.mjs",
    "guard": "node scripts/guard-imports.mjs"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^20.19.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.0",
    "typescript": "5.8.2",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
