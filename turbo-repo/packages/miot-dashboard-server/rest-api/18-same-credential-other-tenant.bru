meta {
  name: One credential, other tenant
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/tenants/{{otherTenant}}/scopes/{{scopeId}}/dashboards/{{slug}}/capabilities
  body: none
  auth: none
}

headers {
  x-dev-user: {{bothTenantsUser}}
}

docs {
  The same credential as the previous request, the same scope id and the same
  slug — only the tenant differs. The role is the one held in this tenant, an
  Editor, rather than the Consumer carried over from the last request. Roles
  do not follow the caller between tenants.
}

assert {
  res.status: eq 200
  res.body.readOnly: eq false
  res.body.canEdit: eq true
}
