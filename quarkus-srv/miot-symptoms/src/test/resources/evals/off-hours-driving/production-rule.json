{
  "source": "gps_signal",
  "activation": "signal.trip.active && !signal.trip.double_driver && signal.gps.moving && signal.local_hour > 1.5 && signal.local_hour < 6",
  "levels": [
    { "icu": 1, "applies": true, "when": "signal.local_hour < 2" },
    { "icu": 2, "applies": true, "when": "signal.local_hour >= 2 && signal.local_hour < 2.5 || signal.local_hour * 60.0 >= 340" },
    { "icu": 3, "applies": true, "when": "signal.local_hour >= 2.5 && signal.local_hour * 60.0 < 340 && sostenido_s < 2700" },
    { "icu": 4, "applies": true, "when": "signal.local_hour >= 2.5 && signal.local_hour * 60.0 < 340 && sostenido_s >= 2700" }
  ],
  "lifecycle": {
    "open": "caso.condicion_s >= 0",
    "close": "caso.normal_s >= 0",
    "levelDown": true
  }
}
