{
  "name": "@microboxlabs/miot-dashboard-ui",
  "version": "0.1.0",
  "description": "Reusable dashboard UI utilities using the MIOT dashboard contract.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/microboxlabs/modulariot",
    "directory": "turbo-repo/packages/miot-dashboard-ui"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit && node scripts/guard-imports.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@microboxlabs/miot-dashboard-contract": "^0.5.0",
    "zod": "^3.23.8",
    "handlebars": "^4.7.9"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@vitest/coverage-v8": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.8.2",
    "vitest": "^5.0.0",
    "react": "19.2.3",
    "@types/react": "19.2.10",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
