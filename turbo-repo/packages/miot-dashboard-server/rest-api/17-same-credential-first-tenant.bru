meta {
  name: One credential, first tenant
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/tenants/{{tenant}}/scopes/{{scopeId}}/dashboards/{{slug}}/capabilities
  body: none
  auth: none
}

headers {
  x-dev-user: {{bothTenantsUser}}
}

docs {
  This request and the next send the same credential and differ only in the
  tenant in the path. Both succeed, which is the point of the design: someone
  who works in several tenants switches between them without a new token and
  without authenticating again.

  Here they are a Consumer, so they may read and nothing else.
}

assert {
  res.status: eq 200
  res.body.readOnly: eq true
  res.body.canEdit: eq false
}
