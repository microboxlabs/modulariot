{
  "source": "gps_signal",
  "activation": "signal.trip.active && signal.road.maxspeed_osm > 0",
  "measure": {
    "expression": "double(int(signal.gps.speed_kmh + 0.5)) - signal.road.maxspeed_osm",
    "label": "Exceso sobre el límite",
    "unit": "km/h"
  },
  "levels": [
    { "icu": 1, "applies": true, "when": "measure > 0 && measure < 5" },
    { "icu": 2, "applies": true, "when": "measure >= 5 && measure < 11" },
    { "icu": 3, "applies": true, "when": "measure >= 11 && measure <= 21" },
    { "icu": 4, "applies": true, "when": "measure > 21 && held_s >= 60" }
  ],
  "lifecycle": {
    "open": "case.condition_s >= 60 && case.level >= 2",
    "close": "case.normal_s >= 0 && case.level < 4 || case.normal_s >= 120",
    "levelDown": true
  }
}
