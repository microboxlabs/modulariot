meta {
  name: List dashboards in a scope
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/tenants/{{tenant}}/scopes/{{scopeId}}/dashboards
  body: none
  auth: none
}

headers {
  x-dev-user: {{user}}
}

docs {
  The request names the tenant, as {{tenant}} in the path. The credential is
  checked for standing in that tenant, and then in the scope, before the store
  is touched.
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}
